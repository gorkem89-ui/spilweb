{
  "name": "spilweb-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "smtp:test": "node src/scripts/smtpTest.js",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "latest",
    "compression": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "express-validator": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "multer": "latest",
    "mysql2": "latest",
    "nodemailer": "latest",
    "sharp": "latest",
    "swagger-jsdoc": "latest",
    "swagger-ui-express": "latest",
    "winston": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "nodemon": "latest",
    "prettier": "latest"
  }
}
